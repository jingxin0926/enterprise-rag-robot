# ============================================================
# 应用基础配置
# ============================================================
# 运行环境：dev / test / prod
APP_ENV=dev
APP_NAME=smart-qa-system
APP_VERSION=0.1.0
# 监听端口
APP_PORT=8000
# 是否开启 Debug
APP_DEBUG=true

# ============================================================
# 日志配置
# ============================================================
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 日志文件目录
LOG_DIR=logs
# 是否输出到控制台
LOG_CONSOLE=true

# ============================================================
# DeepSeek 大模型
# ============================================================
# 申请地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 默认对话模型：deepseek-chat（V3）/ deepseek-reasoner（R1）
DEEPSEEK_MODEL=deepseek-chat
# 温度
DEEPSEEK_TEMPERATURE=0.3
# 最大输出 token
DEEPSEEK_MAX_TOKENS=2048
# 请求超时（秒）
DEEPSEEK_TIMEOUT=60

# ============================================================
# 后续阶段会用到的配置（P1 之后逐步启用）
# ============================================================
# Redis（P1 会话记忆）
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ============================================================
# 安全配置（生产必须修改）
# ============================================================
# JWT 签名密钥（生产请用随机长字符串，如: openssl rand -hex 32）
JWT_SECRET_KEY=please-change-this-secret-in-env
# 初始管理员密码（生产请修改为强密码）
ADMIN_INIT_PASSWORD=please-change-this-password-in-env

# MySQL（P5 元数据）
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=robot

# Qdrant 向量库（P2）
# QDRANT_HOST=127.0.0.1
# QDRANT_PORT=6333
# QDRANT_API_KEY=

# Elasticsearch（P3 混合检索）
# ES_HOSTS=http://127.0.0.1:9200
# ES_USERNAME=
# ES_PASSWORD=

# ============================================================
# Langfuse 可观测性（可选，不配置则自动禁用）
# ============================================================
LANGFUSE_PUBLIC_KEY=pk-xxx
LANGFUSE_SECRET_KEY=sk-xxx
LANGFUSE_HOST=https://cloud.langfuse.com

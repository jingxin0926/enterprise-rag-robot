# ============================================================
# 应用基础配置
# ============================================================
# 运行环境：dev / test / prod
APP_ENV=dev
APP_NAME=smart-qa-system
APP_VERSION=0.1.0
# 监听端口
APP_PORT=8000
# 是否开启 Debug
APP_DEBUG=true

# ============================================================
# 日志配置
# ============================================================
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 日志文件目录
LOG_DIR=logs
# 是否输出到控制台
LOG_CONSOLE=true

# ============================================================
# DeepSeek 大模型
# ============================================================
# 申请地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 默认对话模型：deepseek-chat（V3）/ deepseek-reasoner（R1）
DEEPSEEK_MODEL=deepseek-chat
# 温度
DEEPSEEK_TEMPERATURE=0.3
# 最大输出 token
DEEPSEEK_MAX_TOKENS=2048
# 请求超时（秒）
DEEPSEEK_TIMEOUT=60

# ============================================================
# Redis（会话记忆 / 限流）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================================
# 安全配置（生产必须修改）
# ============================================================
# JWT 签名密钥（生产请用随机长字符串，如: openssl rand -hex 32）
JWT_SECRET_KEY=please-change-this-secret-in-env
# 初始管理员密码（生产请修改为强密码）
ADMIN_INIT_PASSWORD=please-change-this-password-in-env

# MySQL（知识库元数据，Docker 部署由 Compose 注入 MYSQL_HOST=mysql）
MYSQL_PORT=3306
MYSQL_USER=smartqa
MYSQL_PASSWORD=please-change-mysql-app-password
MYSQL_DATABASE=smart_qa
MYSQL_ROOT_PASSWORD=please-change-mysql-root-password

# 异步文档入库任务
DOCUMENT_TASK_MAX_RETRIES=3

# RAG 检索质量门禁：双路命中优先，单路向量需达到强相似度阈值才允许回答。
RAG_VECTOR_SCORE_THRESHOLD=0.3
RAG_STRONG_VECTOR_SCORE=0.72
RAG_MIN_BM25_SCORE=1.0
RAG_LLM_EVIDENCE_VALIDATOR_ENABLED=true

# Qdrant 向量库
# 本地开发不配置时使用 data/qdrant_storage 文件模式。
# 云上 / Docker 部署建议使用独立 Qdrant Server。
# QDRANT_URL 优先级高于 QDRANT_HOST + QDRANT_PORT。
QDRANT_URL=
QDRANT_HOST=
QDRANT_PORT=6333
# Docker Compose 生产部署必须填写；Qdrant 不对公网暴露，但仍需启用容器间鉴权。
QDRANT_API_KEY=please-change-qdrant-api-key
QDRANT_LOCAL_PATH=data/qdrant_storage

# Elasticsearch（P3 混合检索）
# ES_HOSTS=http://127.0.0.1:9200
# ES_USERNAME=
# ES_PASSWORD=

# ============================================================
# Langfuse 可观测性（可选，不配置则自动禁用）
# ============================================================
LANGFUSE_PUBLIC_KEY=pk-xxx
LANGFUSE_SECRET_KEY=sk-xxx
LANGFUSE_HOST=https://cloud.langfuse.com
